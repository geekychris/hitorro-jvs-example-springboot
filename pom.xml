        <!-- Spring Boot Web MVC (Boot 4 renamed spring-boot-starter-web) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Keep Jackson 2 (com.fasterxml.jackson) for HTTP JSON: the HiTorro
             libraries hand JsonNode values from Jackson 2 to the controllers.
             Selected with spring.http.converters.preferred-json-mapper=jackson2. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jackson2</artifactId>
        </dependency>

