    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Copy type definitions and OpenNLP models for runtime -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-type-configs</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/config/types</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../config/types</directory>
                                    <includes><include>*.json</include></includes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-schemas</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/config/schemas</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../config/schemas</directory>
                                    <includes><include>*.schema.json</include></includes>
                                </resource>
                            </resources>
                            <overwrite>true</overwrite>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <distributionManagement>
        <repository>
            <id>hitorro-local</id>
            <name>Hitorro Local Maven Repository</name>
            <url>file://${user.home}/code/hitorro-maven</url>
        </repository>
        <snapshotRepository>
            <id>hitorro-local</id>
            <name>Hitorro Local Maven Repository (Snapshots)</name>
            <url>file://${user.home}/code/hitorro-maven</url>
        </snapshotRepository>
    </distributionManagement>

